{
  "name": "package",
  "version": "1.0.0",
  "description": "WarriorSim",
  "main": "main.js",
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "gulp": "^5.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-cssnano": "^2.1.3",
    "gulp-minify": "^3.1.0",
    "gulp-sass": "^4.1.0",
    "gulp-uglify": "^3.0.2"
  },
  "scripts": {
    "test": "node test/simulation-regressions.test.js && node --test test/wasm/reference.test.js test/wasm/extra-reference.test.js test/wasm/worker.test.js",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-dist.ps1",
    "dev": "gulp",
    "start": "gulp",
    "wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File wasm/build.ps1",
    "build:css": "gulp sass",
    "dist:full": "npm run build:css && npm run dist",
    "test:wasm": "node --test test/wasm/native.test.js test/wasm/extra-native.test.js test/wasm/native-api.test.js",
    "benchmark": "node test/wasm/benchmark.js",
    "test:regressions": "node test/simulation-regressions.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "gulp-rename": "^2.0.0",
    "gulp-strip-code": "^0.1.4"
  }
}
